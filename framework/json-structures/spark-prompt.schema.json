      "type": "string"
    },
    "role_identity": {
      "type": "object"
    },
    "objective": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "output_specification": {
      "type": "object"
    },
    "examples": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    },
    "notes": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
